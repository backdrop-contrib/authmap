<?php

/**
 * @file
 * Tests for authmap.module.
 */

/**
 * Tests that {authmap}.authname is matched case-sensitively.
 */
class UserAuthmapCaseSensitivityTestCase extends BackdropWebTestCase {

  /**
   * The account the test authname is mapped to.
   *
   * @var object
   */
  protected $account;

  protected function setUp() {
    parent::setUp(array('authmap'));

    require_once BACKDROP_ROOT . '/core/includes/update.inc';
    module_load_include('install', 'user');

    $this->account = $this->backdropCreateUser();
    authmap_set_authmaps($this->account, array('authname_poll' => 'kathy'));
  }

  /**
   * Returns TRUE if the site runs on MySQL or MariaDB.
   */
  protected function isMysql() {
    return Database::getConnection()->databaseType() == 'mysql';
  }

  /**
   * Returns the collation of {authmap}.authname, or NULL if not on MySQL.
   */
  protected function authnameCollation() {
    if (!$this->isMysql()) {
      return NULL;
    }
    $column = db_query("SHOW FULL COLUMNS FROM {authmap} LIKE 'authname'")->fetchAssoc();
    return $column['Collation'];
  }

  /**
   * Redefines {authmap}.authname with or without the binary flag.
   *
   * Used to reproduce the pre-update state of a site whose column still uses
   * a case-insensitive collation.
   *
   * @param bool $binary
   *   Whether the column should be declared binary.
   */
  protected function setAuthnameBinary($binary) {
    $spec = array(
      'type' => 'varchar',
      'length' => 128,
      'not null' => TRUE,
      'default' => '',
      'description' => 'Unique authentication name.',
    );
    if ($binary) {
      $spec['binary'] = TRUE;
    }
    db_drop_unique_key('authmap', 'authname');
    db_change_field('authmap', 'authname', 'authname', $spec);
    db_add_unique_key('authmap', 'authname', array('authname'));
  }

  /**
   * Tests that the schema and the installed column are both case-sensitive.
   */
  function testAuthnameColumnIsBinary() {
    $schema = backdrop_get_schema('authmap');
    $this->assertTrue(!empty($schema['fields']['authname']['binary']), 'The authname column is declared binary in the schema.');

    if ($this->isMysql()) {
      $collation = $this->authnameCollation();
      $this->assertEqual(substr($collation, -4), '_bin', format_string('The installed authname column uses a binary collation (@collation).', array('@collation' => $collation)));
    }
  }

  /**
   * Tests that user_external_load() only matches an identical authname.
   */
  function testExternalLoadIsCaseSensitive() {
    $account = authmap_external_load('kathy');
    $this->assertTrue($account && $account->uid == $this->account->uid, 'The exact authname loads the mapped account.');

    foreach (array('kATHy', 'KATHY', 'Kathy', 'kathy ', ' kathy', "kathy\t") as $variant) {
      $this->assertFalse(authmap_external_load($variant), format_string('user_external_load() rejects %variant.', array('%variant' => $variant)));
    }
  }

  /**
   * Tests that user_get_authmaps() only matches an identical authname.
   */
  function testGetAuthmapsIsCaseSensitive() {
    $this->assertIdentical(authmap_get_authmaps('kathy'), array('poll' => 'kathy'), 'The exact authname returns its authmap.');

    foreach (array('kATHy', 'KATHY', 'kathy ', ' kathy') as $variant) {
      $this->assertIdentical(authmap_get_authmaps($variant), 0, format_string('user_get_authmaps() rejects %variant.', array('%variant' => $variant)));
    }
  }

  /**
   * Tests that the functions stay case-sensitive on an unconverted column.
   *
   * A site that has not yet run authmap_update_1100() still holds the column
   * under a case-insensitive collation. The comparison in PHP has to keep the
   * bypass closed there too.
   */
  function testUnconvertedColumnIsStillSafe() {
    if (!$this->isMysql()) {
      $this->pass('Only MySQL and MariaDB compare varchar values case-insensitively; nothing to test.');
      return;
    }

    $this->setAuthnameBinary(FALSE);

    // Confirm the database really did go back to matching case-insensitively,
    // otherwise the rest of this test proves nothing.
    $uid = db_query('SELECT uid FROM {authmap} WHERE authname = :authname', array(':authname' => 'KATHY'))->fetchField();
    $this->assertEqual($uid, $this->account->uid, 'With the old collation the database matches a case-varied authname.');

    $this->assertFalse(authmap_external_load('KATHY'), 'user_external_load() still rejects a case-varied authname on an unconverted column.');
    $this->assertFalse(authmap_external_load('kathy '), 'user_external_load() still rejects a trailing-space authname on an unconverted column.');
    $this->assertIdentical(authmap_get_authmaps('KATHY'), 0, 'user_get_authmaps() still rejects a case-varied authname on an unconverted column.');

    $account = authmap_external_load('kathy');
    $this->assertTrue($account && $account->uid == $this->account->uid, 'The exact authname still loads the mapped account.');
  }

  /**
   * Tests that authmap_update_1100() converts the column and keeps the data.
   */
  function testUpdateConvertsColumn() {
    if (!$this->isMysql()) {
      $this->pass('The binary flag only applies to MySQL and MariaDB; nothing to convert.');
      return;
    }

    $this->setAuthnameBinary(FALSE);
    $this->assertNotEqual(substr($this->authnameCollation(), -4), '_bin', 'The column starts out with a case-insensitive collation.');

    authmap_update_1101();

    $collation = $this->authnameCollation();
    $this->assertEqual(substr($collation, -4), '_bin', format_string('The update converted the column to a binary collation (@collation).', array('@collation' => $collation)));
    $this->assertTrue(db_index_exists('authmap', 'authname'), 'The update left the unique key in place.');

    $uid = db_query('SELECT uid FROM {authmap} WHERE authname = :authname', array(':authname' => 'KATHY'))->fetchField();
    $this->assertFalse($uid, 'After the update the database no longer matches a case-varied authname.');

    $uid = db_query('SELECT uid FROM {authmap} WHERE authname = :authname', array(':authname' => 'kathy'))->fetchField();
    $this->assertEqual($uid, $this->account->uid, 'The existing mapping survived the conversion.');
  }

  /**
   * Tests that authmap_update_1101() refuses to convert colliding rows.
   *
   * The unique key normally makes case collisions impossible, so this only
   * happens on a site that dropped it. Converting would silently leave one of
   * the rows authenticating the wrong account, so the update stops instead.
   */
  function testUpdateRefusesCollidingRows() {
    if (!$this->isMysql()) {
      $this->pass('Case collisions cannot occur on this database; nothing to detect.');
      return;
    }

    $other = $this->backdropCreateUser();
    $this->setAuthnameBinary(FALSE);
    db_drop_unique_key('authmap', 'authname');
    db_insert('authmap')
      ->fields(array('uid' => $other->uid, 'authname' => 'KATHY', 'module' => 'book'))
      ->execute();

    try {
      authmap_update_1101();
      $this->fail('authmap_update_1101() converted a table holding case-colliding authnames.');
    }
    catch (BackdropUpdateException $e) {
      $this->pass('authmap_update_1101() refused to convert a table holding case-colliding authnames.');
      $this->assertTrue(strpos($e->getMessage(), 'kathy') !== FALSE, 'The exception names the colliding authname.');
    }

    $this->assertNotEqual(substr($this->authnameCollation(), -4), '_bin', 'The failed update left the column unchanged.');
    $this->assertEqual(db_query('SELECT COUNT(*) FROM {authmap}')->fetchField(), 2, 'The failed update left the rows unchanged.');
  }

}
